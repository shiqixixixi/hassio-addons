#!/command/with-contenv bashio
# shellcheck shell=bash

# Use Alpine Linux default Apache configuration
# Just update the document root and enable PHP

# Completely replace the Apache configuration with a minimal working version
# that doesn't manually load any modules

# First, delete any existing httpd.conf file to start fresh
rm -f /etc/apache2/httpd.conf

# Create a brand new httpd.conf that doesn't load any modules manually
# Apache will automatically load the necessary modules
cat > /etc/apache2/httpd.conf << 'EOF'
# Apache HTTP Server Configuration File
ServerRoot "/usr"
Listen 80
ServerName localhost

# Don't load any modules manually - Apache will load them automatically
# based on the modules available in the system

# Basic server configuration
DocumentRoot "/app/public"
User apache
Group apache

# Security settings
<Directory />
    AllowOverride None
    Require all denied
</Directory>

# Document root configuration
<Directory "/app/public">
    Options Indexes FollowSymLinks
    AllowOverride All
    Require all granted
</Directory>

# DirectoryIndex settings
DirectoryIndex index.php index.html

# PHP settings
AddType application/x-httpd-php .php

# Log settings
ErrorLog /proc/self/fd/2
LogLevel warn
CustomLog /proc/self/fd/1 combined
EOF

# Create a simple PHP info file for testing (optional)
echo "<?php phpinfo(); ?>" > /app/public/info.php

# Start Apache in the foreground
exec httpd -D FOREGROUND

