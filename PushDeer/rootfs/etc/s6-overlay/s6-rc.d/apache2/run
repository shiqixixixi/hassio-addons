#!/command/with-contenv bashio
# shellcheck shell=bash

# Use Alpine Linux default Apache configuration
# Just update the document root and enable PHP

# Use Alpine Linux default Apache configuration
# The apache2 package already comes with a working configuration

# Just update the document root in the default configuration
if [ -f /etc/apache2/httpd.conf ]; then
    # Update document root
    sed -i 's|DocumentRoot "/var/www/localhost/htdocs"|DocumentRoot "/app/public"|g' /etc/apache2/httpd.conf
    
    # Update directory configuration
    sed -i 's|</Directory>|<Directory "/app/public">\n    Options Indexes FollowSymLinks\n    AllowOverride All\n    Require all granted\n</Directory>|g' /etc/apache2/httpd.conf
    
    # Ensure PHP is enabled
    echo 'AddType application/x-httpd-php .php' >> /etc/apache2/httpd.conf
    echo 'DirectoryIndex index.php index.html' >> /etc/apache2/httpd.conf
else
    # Fallback to a minimal working configuration if default doesn't exist
    cat > /etc/apache2/httpd.conf << EOF
ServerRoot "/usr"
Listen 80
Include /etc/apache2/conf.d/*.conf
DocumentRoot "/app/public"
<Directory "/app/public">
    Options Indexes FollowSymLinks
    AllowOverride All
    Require all granted
</Directory>
AddType application/x-httpd-php .php
DirectoryIndex index.php index.html
ErrorLog /proc/self/fd/2
CustomLog /proc/self/fd/1 combined
EOF
fi

# Start Apache
exec httpd -D FOREGROUND
