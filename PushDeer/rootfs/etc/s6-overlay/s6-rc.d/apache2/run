#!/command/with-contenv bashio
# shellcheck shell=bash

# Use Alpine Linux default Apache configuration
# Just update the document root and enable PHP

# For webdevops/php-apache:8.0 image, Apache is already configured
# We just need to update the document root and some settings

# Update the document root in the Apache configuration
# webdevops/php-apache uses /opt/docker/etc/httpd/vhost.conf for vhost configuration
cat > /opt/docker/etc/httpd/vhost.conf << 'EOF'
#######################################
# Vhost
#######################################

<VirtualHost *:80>
    ServerName localhost
    DocumentRoot "/app/public"
    <Directory /app/public>
        Options FollowSymLinks MultiViews
        AllowOverride All
        Order allow,deny
        allow from all
    </Directory>
    ErrorLog /proc/self/fd/2
    CustomLog /proc/self/fd/1 combined
</VirtualHost>
EOF

# Create a simple PHP info file for testing (optional)
echo "<?php phpinfo(); ?>" > /app/public/info.php

# Start Apache using the webdevops image's default command
exec /usr/sbin/httpd -D FOREGROUND


