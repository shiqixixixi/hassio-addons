#!/command/with-contenv bashio
# shellcheck shell=bash

# Use Alpine Linux default Apache configuration
# Just update the document root and enable PHP

# Update document root in httpd.conf
cat > /etc/apache2/httpd.conf << EOF
ServerRoot "/usr"
Listen 80
LoadModule mpm_prefork_module modules/mod_mpm_prefork.so
LoadModule dir_module modules/mod_dir.so
LoadModule mime_module modules/mod_mime.so
LoadModule php_module /usr/lib/apache2/modules/libphp83.so
<IfModule dir_module>
    DirectoryIndex index.php index.html
</IfModule>
AddType application/x-httpd-php .php
AddType application/x-httpd-php-source .phps
EOF

# Remove any existing php83-module.conf if it exists
rm -f /etc/apache2/conf.d/php83-module.conf

# Create virtual host configuration
cat > /etc/apache2/conf.d/vhost.conf << EOF
<VirtualHost *:80>
    DocumentRoot "/app/public"
    ServerName localhost
    ErrorLog /proc/self/fd/2
    CustomLog /proc/self/fd/1 combined
    <Directory "/app/public">
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>
EOF

# Start Apache
exec httpd -D FOREGROUND