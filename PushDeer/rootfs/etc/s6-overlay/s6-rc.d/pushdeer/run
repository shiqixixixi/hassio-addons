#!/command/with-contenv bashio
# shellcheck shell=bash

# Set up environment variables
export REDIS_HOST=$(bashio::config redis_host)
export REDIS_PORT=$(bashio::config redis_port)
export REDIS_PASSWORD=$(bashio::config redis_password)

# Configure gorush for iOS push notifications
cat > /app/push/ios.yml << EOF
services:
  push:
    - name: "ios"
      enabled: true
      mode: "grpc"
      port: 9001
      cert: "/app/push/c.p12"
      key: ""
      password: ""
      topic: "com.pushdeer.self.ios"
      production: false
      redis:
        addr: "${REDIS_HOST}:${REDIS_PORT}"
        password: "${REDIS_PASSWORD}"
        db: 0
      queue:
        name: "ios"
        workers: 4
        retry: 3
        timeout: 60
      log:
        level: "info"
        format: "json"
EOF

# Configure gorush for iOS Clip push notifications
cat > /app/push/clip.yml << EOF
services:
  push:
    - name: "ios-clip"
      enabled: true
      mode: "grpc"
      port: 9002
      cert: "/app/push/cc.p12"
      key: ""
      password: ""
      topic: "com.pushdeer.self.ios.Clip"
      production: false
      redis:
        addr: "${REDIS_HOST}:${REDIS_PORT}"
        password: "${REDIS_PASSWORD}"
        db: 0
      queue:
        name: "ios-clip"
        workers: 4
        retry: 3
        timeout: 60
      log:
        level: "info"
        format: "json"
EOF

# Make gorush executable if it exists
# Check multiple possible locations for gorush
gorush_path=""
if [ -f /data/gorush ]; then
    gorush_path="/data/gorush"
elif [ -f /app/push/gorush-with-mipush/gorush ]; then
    gorush_path="/app/push/gorush-with-mipush/gorush"
elif [ -f /app/push/gorush ]; then
    gorush_path="/app/push/gorush"
fi

if [ -n "$gorush_path" ]; then
    chmod +x "$gorush_path"
    # Start gorush for iOS
    exec "$gorush_path" -c /app/push/ios.yml
else
    # If gorush doesn't exist, just sleep
    echo "gorush not found, sleeping..."
    exec sleep infinity
fi